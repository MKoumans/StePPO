FROM registry.codeocean.com/codeocean/ubuntu:20.04-cuda11.7.0-cudnn8

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/0.12.15/install.sh \
    | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    JAX_PLATFORMS=cpu \
    PATH="/opt/venv/bin:$PATH"

RUN uv python install 3.11

COPY pyproject.toml uv.lock /tmp/deps/
WORKDIR /tmp/deps
# Do not install GPU packages
RUN uv sync --frozen --no-install-project --python 3.11 \
    --no-install-package jax-cuda12-pjrt --no-install-package jax-cuda12-plugin \
    --no-install-package nvidia-cublas-cu12 --no-install-package nvidia-cuda-cccl-cu12 \
    --no-install-package nvidia-cuda-cupti-cu12 --no-install-package nvidia-cuda-nvcc-cu12 \
    --no-install-package nvidia-cuda-nvrtc-cu12 --no-install-package nvidia-cuda-runtime-cu12 \
    --no-install-package nvidia-cudnn-cu12 --no-install-package nvidia-cufft-cu12 \
    --no-install-package nvidia-cusolver-cu12 --no-install-package nvidia-cusparse-cu12 \
    --no-install-package nvidia-nccl-cu12 --no-install-package nvidia-nvjitlink-cu12 \
    --no-install-package nvidia-nvshmem-cu12

# PyTorch 2.4.1 as in docker/Dockerfile.deeponet-gpu, CPU build.
RUN uv venv /opt/deeponet --python 3.11 \
    && uv pip install --python /opt/deeponet/bin/python \
        torch==2.4.1 --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --python /opt/deeponet/bin/python \
        deepxde torchdiffeq scipy numpy matplotlib pyyaml huggingface_hub
ENV DEEPONET_PYTHON=/opt/deeponet/bin/python \
    DDE_BACKEND=pytorch

WORKDIR /code
